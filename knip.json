{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  // House style: comments stay in the JSONC config (same idea as .oxlintrc.json).
  // Every ignore below carries the reason it exists. Prefer adding entry
  // evidence over an ignore; ignores are last, never to hide real dead code.
  //
  // Seven plugins required by the knip adoption spec (#142), enabled explicitly
  // rather than left to auto-detection:
  "nest": true,
  "jest": true,
  "biome": true,
  "prettier": true,
  "husky": true,
  "lint-staged": true,
  "github-actions": true,
  // Shell operator scripts (scripts/**/*.sh) are outside knip scope entirely:
  // knip does not parse shell, and they are referenced only from operator
  // docs. No ignore entries are spent on them; audit separately if desired.
  // Entry evidence below is the union the spec requires: package script
  // targets are picked up from package.json automatically, the Jest plugin
  // covers both jest configs plus every spec, and only the roots no script
  // or test edge reaches are listed by hand.
  // Constants and helpers that are used only beside their definition should
  // lose the `export` keyword, not show up as dead code. Symbols nothing
  // outside the defining module references remain reportable.
  "ignoreExportsUsedInFile": true,
  "ignore": [
    // CodeQL fixtures are query inputs, not application source or dependencies.
    ".github/codeql/tests/**"
  ],
  "entry": [
    // Nest bootstrap: package `start` points at dist/main.js; the nest plugin
    // does not always map that back to the TypeScript entry on its own.
    "src/main.ts",
    // Operator CLI surfaces. scripts/cli/cli.mjs resolves each one through
    // cliRunnerDescriptor and loadCliRunner, which picks `dist/cli/*.js` in
    // production and the `.ts` source under tsx, so knip cannot follow those
    // imports statically. Entry status also treats their exports as public
    // surface.
    "src/cli/billing-statement.ts",
    "src/cli/quota-reconcile.ts",
    "src/cli/usage-report.ts",
    "src/cli/usage-prune.ts",
    "src/cli/writing-chart-upload-sweep.ts",
    // Container runtime evidence that package.json scripts do not name:
    // Dockerfile ENTRYPOINT; compose uses the same bootstrap as entrypoint.
    "scripts/runtime/runtime-entrypoint.mjs",
    // Compose invokes these through bind mounts and a separate k6 container,
    // so their runtime edges are outside Knip's JavaScript import graph.
    "scripts/ops/capacity-benchmark/capacity-benchmark-k6.js",
    "scripts/ops/capacity-benchmark/capacity-benchmark-seed.mjs",
    "scripts/ops/capacity-benchmark/capacity-benchmark-reset-refresh-tokens.mjs",
    "scripts/ops/capacity-benchmark/capacity-benchmark-start-app.mjs",
    "scripts/ops/capacity-benchmark/capacity-benchmark-support.mjs",
    // #1018 type-check probes are standalone tsc project entries, not imports.
    "scripts/ops/kysely-evaluation/kysely-types-probe.ts",
    "scripts/ops/kysely-evaluation/empty-types-probe.ts",
    // Operator CLI invoked by a documented host path (docs/operations), not by
    // package scripts, tests, or the container image; live runbook command.
    "scripts/cli/upload-speaking-audio.mjs",
    // Hand-written types for scripts/cli/cli-options.cjs (plain CJS); the spec
    // and cli.mjs reach the .cjs through TypeScript, so without this knip
    // reports a live file as unused.
    "scripts/cli/cli-options.d.cts",
    // Hand-written types for the shared operator mutation safety helper.
    "scripts/cli/operator-safety.d.cts",
    // Hand-written types for the dynamic CLI runner's source and built exports.
    "scripts/cli/load-cli-runner.d.cts",
    // The shell drift-check fixture invokes this generator; Knip does not follow that edge.
    "scripts/ops/monitoring/update-alert-rules-fingerprint.mjs",
    // Direct `node --test` target in package.json, kept explicit because Knip
    // does not treat this monitoring test target as an entry.
    "scripts/ops/monitoring/update-alert-rules-fingerprint.spec.mjs",
    // Hand-written types for scripts/checks/prisma-drift/prisma-drift.cjs — same reason.
    "scripts/checks/prisma-drift/prisma-drift.d.cts",
    // Hand-written types for scripts/ci/boot/ci-boot-config.cjs — same reason.
    "scripts/ci/boot/ci-boot-config.d.cts",
    // Hand-written types for scripts/ci/push/ci-push-filter.cjs — same reason.
    "scripts/ci/push/ci-push-filter.d.cts",
    // Hand-written types for scripts/checks/changed/verify-summary.cjs — same reason.
    "scripts/checks/changed/verify-summary.d.cts",
    // Hand-written types for scripts/checks/changed/merged-coverage.cjs — same reason.
    "scripts/checks/changed/merged-coverage.d.cts",
    // Hand-written types for check-changed.mjs — test imports reach the runtime
    // module through TypeScript declaration boundaries.
    "scripts/checks/changed/check-changed.d.mts",
    // Hand-written types for check-batch.cjs, which the spec reaches through
    // TypeScript, so knip sees no import edge to the .cjs itself.
    "scripts/checks/changed/check-batch.d.cts",
    // Hand-written types for check-architecture.mjs; the spec reaches the .mjs
    // through TypeScript, so without this knip reports a live file as unused.
    "scripts/checks/architecture/check-architecture.d.mts",
    // Hand-written types for the dependency-cruiser cache helper; its .cjs is
    // reached only through check-architecture.mjs, so knip sees no edge to it.
    "scripts/checks/architecture/dependency-cruiser-cache.d.cts",
    // Hand-written types for scripts/checks/jest/jest-worker-cap.cjs — same reason:
    // Jest reaches it through jest.config.cjs, outside the TypeScript graph.
    "scripts/checks/jest/jest-worker-cap.d.cts",
    // Hand-written types for scripts/checks/knip/knip-cache-args.cjs — same reason:
    // the spec reaches the .cjs through TypeScript, so without this knip
    // reports a live file as unused.
    "scripts/checks/knip/knip-cache-args.d.cts",
    // Hand-written types for the Kysely and Prisma benchmark rows; the
    // benchmarks import it only through JSDoc typedefs, which knip does not follow.
    "scripts/ops/kysely-evaluation/benchmark.d.mts",
    // Hand-written types for Vault's PgBouncer budget module; Knip does not
    // follow TypeScript's adjacent-declaration lookup from the .mjs import.
    "ops/vault/pgbouncer-budget.d.mts",
    // Hand-written types for the PgBouncer exporter; Knip does not follow
    // TypeScript's adjacent-declaration lookup from the .mjs import.
    "scripts/ops/monitoring/pgbouncer-exporter.d.mts",
    // Hand-written types for scripts/runtime/dev-runner.mjs.
    "scripts/runtime/dev-runner.d.mts",
    // Invoked by .husky/commit-msg, a shell hook knip does not parse, so no
    // import or test edge reaches it from the JavaScript graph.
    "scripts/checks/hooks/commit-message.mjs",
    // Invoked by the Claude Code PostToolUse hook in .claude/settings.json, which
    // knip does not parse.
    "scripts/checks/hooks/issue-triage-hook.mjs",
    "scripts/checks/hooks/issue-triage-hook.spec.mjs",
    // Child Jest config for the Postgres crash-durability worker process.
    "jest.config.db-worker.cjs"
  ],
  "ignoreBinaries": [
    // HashiCorp Vault CLI — operator workstation/image binary, not an npm package.
    "vault"
  ],
  "ignoreDependencies": [
    // Referenced by nest-cli.json `collection`; shipped for Nest schematics,
    // not imported by application code.
    "@nestjs/schematics",
    // Grafana k6 resolves its built-in modules inside the pinned runner image.
    "k6"
  ]
}
