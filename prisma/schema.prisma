// The control-plane schema, generated by `prisma db pull` against a database
// built from every file in `database/migrations/` and then renamed to the
// TypeScript names the repositories already use (ADR-0088, #40).
//
// Migrations remain what builds a database; this file describes the same
// schema so that a renamed column becomes a compile error instead of a runtime
// surprise, and so `pnpm check:prisma-drift` can prove the two still agree.
//
// Every `///` comment below that names a migration marks an object this schema
// language cannot declare. Those objects live only in SQL, and the migration is
// where they are changed.

datasource db {
  provider = "postgresql"
}

generator client {
  provider = "prisma-client"

  // Written outside `src/` and outside version control, so a review contains
  // only the schema and hand-written code. `src/` and `dist/` are trees of
  // equal depth below the repository root, so one `@prisma-client/*` specifier
  // resolves to this directory from the source and to its compiled form from
  // the build output.
  output = "../dist/generated/prisma"

  // CommonJS, because `dist/` is CommonJS: the SWC build rewrites this
  // application's imports to `require`, and an ESM client would not load
  // beside them. The build emits a runnable `.js` beside each generated `.ts`.
  moduleFormat = "cjs"

  // Partial indexes are a preview feature in Prisma 7 and GA in Prisma 8. The
  // control plane keeps seven of them as database-enforced invariants - "one
  // open invitation", "one open token", the Sandbox dispatch budget - so they
  // are declared here rather than left as objects this schema cannot see.
  // Without the flag `prisma db pull` cannot express what it reads and the
  // drift check reports those indexes as missing.
  previewFeatures = ["partialIndexes"]
}

/// API keys, one per Organization.
///
/// `CHECK` constraints `api_keys_key_hash_check` and `api_keys_status_check`
/// are owned by migration 0001.
model ApiKey {
  id                   String       @id
  organizationId       String       @map("organization_id")
  keyHash              Bytes        @unique(map: "api_keys_hash_uq") @map("key_hash")
  keyPrefix            String       @map("key_prefix")
  name                 String
  scopes               String[]     @default([])
  allowedEnvironments  String[]     @default(["production"]) @map("allowed_environments")
  status               String       @default("active")
  expiresAt            DateTime?    @map("expires_at") @db.Timestamptz(6)
  lastUsedAt           DateTime?    @map("last_used_at") @db.Timestamptz(6)
  revokedAt            DateTime?    @map("revoked_at") @db.Timestamptz(6)
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([organizationId], map: "api_keys_org_idx")
  @@map("api_keys")
}

/// A user's single password identity.
///
/// `CHECK` constraints are owned by migrations 0006 (id, provider,
/// canonical_email) and 0029 (password_hash parameters).
model AuthIdentity {
  id              String      @id
  userAccountId   String      @map("user_account_id")
  provider        String
  canonicalEmail  String      @map("canonical_email")
  passwordHash    String      @map("password_hash")
  createdAt       DateTime    @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @map("updated_at") @db.Timestamptz(6)
  userAccount     UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@unique([provider, canonicalEmail], map: "auth_identities_provider_canonical_email_key")
  @@index([userAccountId], map: "auth_identities_user_account_id")
  @@map("auth_identities")
}

/// The durable outbox every transactional email is written to.
///
/// `CHECK` constraints are owned by migrations 0027 (id, kind, status, attempts,
/// error codes, payload and completion states), 0028 (lease owner), 0030 and
/// 0031 (failure notification), and 0035 (MFA delivery kinds). Two fields carry
/// database comments that this schema language does not yet read.
model EmailDeliveryRequest {
  id                              String   @id
  kind                            String
  status                          String   @default("queued")
  payloadCiphertext               String?  @map("payload_ciphertext")
  attempts                        Int      @default(0)
  lastAttemptAt                   DateTime? @map("last_attempt_at") @db.Timestamptz(6)
  lastErrorCode                   String?  @map("last_error_code")
  cancelReason                    String?  @map("cancel_reason")
  createdAt                       DateTime @map("created_at") @db.Timestamptz(6)
  completedAt                     DateTime? @map("completed_at") @db.Timestamptz(6)
  leaseOwner                      String?  @map("lease_owner")
  leaseExpiresAt                  DateTime? @map("lease_expires_at") @db.Timestamptz(6)
  failureReportedAt               DateTime? @map("failure_reported_at") @db.Timestamptz(6)
  failureNotifyLeaseExpiresAt     DateTime? @map("failure_notify_lease_expires_at") @db.Timestamptz(6)

  @@index([status, createdAt], map: "email_delivery_requests_status_created_idx")
  @@map("email_delivery_requests")
}

/// A pending local sign-up or sign-in verification.
///
/// The partial unique index `email_verification_one_open_token` (one open token
/// per account) is owned by migration 0006. `CHECK` constraints are owned by
/// migrations 0006 (id, token hash), 0018 (consumption reason) and 0022
/// (browser binding and sign-in).
model EmailVerificationToken {
  id                 String      @id
  userAccountId      String      @unique(map: "email_verification_one_open_token", where: raw("(consumed_at IS NULL)")) @map("user_account_id")
  tokenHash          String      @unique(map: "email_verification_tokens_token_hash_key") @map("token_hash")
  expiresAt          DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt         DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt          DateTime    @map("created_at") @db.Timestamptz(6)
  consumedReason     String?     @map("consumed_reason")
  browserBindingHash String?     @map("browser_binding_hash")
  signedInAt         DateTime?   @map("signed_in_at") @db.Timestamptz(6)
  userAccount        UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@map("email_verification_tokens")
}

/// One record per Organization, operation, actor scope, and idempotency key.
///
/// `@@ignore`: the table has no single-column primary key, and its unique
/// constraint includes a nullable column, so Prisma Client cannot address a
/// row by identifier. The conflict target and the lock reads that decide replay
/// versus reject are TypedSQL statements instead (ADR-0088, #39).
///
/// `CHECK` constraints are owned by migrations 0004 (idempotency key,
/// fingerprint, state) and the primary key added by 0013; the scope key unique
/// constraint is added by 0014.
model IdempotencyRecord {
  organizationId     String? @map("organization_id")
  operation          String
  idempotencyKey     String  @map("idempotency_key")
  requestFingerprint Bytes   @map("request_fingerprint")
  state              String
  requestId          String  @map("request_id")
  responseStatus     Int?    @map("response_status")
  responseBody       Json?   @map("response_body")
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  completedAt        DateTime? @map("completed_at") @db.Timestamptz(6)
  expiresAt          DateTime  @map("expires_at") @db.Timestamptz(6)
  actorScope         String   @default("") @map("actor_scope")

  @@unique([organizationId, operation, actorScope, idempotencyKey], map: "idempotency_records_scope_key")
  @@index([expiresAt], map: "idempotency_records_expires_idx")
  @@ignore
  @@map("idempotency_records")
}

/// The append-only Organization audit trail.
///
/// Trigger `organization_audit_events_append_only` is owned by migration 0011.
/// `CHECK` constraints on `action` and `target_type` were extended by
/// migrations 0012, 0014, 0015, 0016, 0017, 0019 and 0021; migration 0011 owns
/// the rest.
model OrganizationAuditEvent {
  id                String       @id
  organizationId    String       @map("organization_id")
  actorUserAccountId String      @map("actor_user_account_id")
  action            String
  outcome           String
  targetType        String       @map("target_type")
  targetId          String       @map("target_id")
  targetLabel       String?      @map("target_label")
  detail            Json?
  requestId         String       @map("request_id")
  occurredAt        DateTime     @map("occurred_at") @db.Timestamptz(6)
  actor             UserAccount  @relation(fields: [actorUserAccountId], references: [id], onUpdate: NoAction)
  organization      Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction)

  @@index([actorUserAccountId], map: "organization_audit_events_actor_idx")
  @@index([organizationId, occurredAt(sort: Desc)], map: "organization_audit_events_org_time_idx")
  @@map("organization_audit_events")
}

/// An Organization's self-service identity provider configuration.
///
/// Trigger `organization_identity_configs_set_updated_at` is owned by
/// migration 0003, which also owns its `CHECK` constraints; migration 0020 adds
/// `organization_identity_configs_jwks_cache_version_check`.
model OrganizationIdentityConfig {
  organizationId        String       @id @map("organization_id")
  issuer                String       @unique(map: "oic_issuer_uq")
  jwksUrl               String?      @map("jwks_url")
  publicKeysJwks        Json?        @map("public_keys_jwks")
  allowedAlgorithms      String[]     @default(["RS256", "ES256"]) @map("allowed_algorithms")
  maxAssertionTtlSeconds Int         @default(300) @map("max_assertion_ttl_seconds")
  status                String       @default("active")
  createdAt             DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  jwksCacheVersion      BigInt       @default(1) @map("jwks_cache_version")
  organization          Organization @relation(fields: [organizationId], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@map("organization_identity_configs")
}

/// A pending invitation to join an Organization.
///
/// The partial unique index `organization_invitations_one_open` (one open
/// invitation per Organization and email) is owned by migration 0010, which
/// also owns this table's `CHECK` constraints.
model OrganizationInvitation {
  id             String       @id
  organizationId String       @map("organization_id")
  email          String
  role           String
  invitedBy      String       @map("invited_by")
  tokenHash      String       @unique(map: "organization_invitations_token_hash_key") @map("token_hash")
  expiresAt      DateTime     @map("expires_at") @db.Timestamptz(6)
  consumedAt     DateTime?    @map("consumed_at") @db.Timestamptz(6)
  createdAt      DateTime     @map("created_at") @db.Timestamptz(6)
  invitedByUser  UserAccount  @relation(fields: [invitedBy], references: [id], onUpdate: NoAction)
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction)

  @@unique([organizationId, email], map: "organization_invitations_one_open", where: raw("(consumed_at IS NULL)"))
  @@index([invitedBy], map: "organization_invitations_invited_by_idx")
  @@index([organizationId], map: "organization_invitations_organization_idx")
  @@map("organization_invitations")
}

/// The membership join between a user account and an Organization.
///
/// Trigger `organization_members_set_updated_at` is owned by migration 0009,
/// which also owns this table's `CHECK` constraints.
model OrganizationMembership {
  organizationId String       @map("organization_id")
  userAccountId  String       @map("user_account_id")
  role           String
  status         String       @default("active")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @default(now()) @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: NoAction)
  userAccount    UserAccount  @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@id([organizationId, userAccountId])
  @@index([userAccountId], map: "organization_members_user_account_idx")
  @@map("organization_members")
}

/// A tenant. Every other control-plane table is scoped by its id.
///
/// Trigger `organizations_set_updated_at` is owned by migration 0002. `CHECK`
/// constraints are owned by migration 0001 (status, rate limit, concurrency,
/// quota), with status extended by 0016 (suspension). The partial index
/// `organizations_created_by_idx` is owned by migration 0014.
model Organization {
  id                         String                      @id
  name                       String
  status                     String                      @default("active")
  entitlements               String[]                    @default([])
  rateLimitRpm               Int                         @default(600) @map("rate_limit_rpm")
  maxConcurrent              Int                         @default(20) @map("max_concurrent")
  monthlyRequestQuota        Int?                        @map("monthly_request_quota")
  hardStopOnQuota            Boolean                     @default(false) @map("hard_stop_on_quota")
  createdAt                  DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                  DateTime                    @default(now()) @map("updated_at") @db.Timestamptz(6)
  createdByUserAccountId     String?                     @map("created_by_user_account_id")
  apiKeys                    ApiKey[]
  auditEvents                OrganizationAuditEvent[]
  identityConfig             OrganizationIdentityConfig?
  invitations                OrganizationInvitation[]
  memberships                OrganizationMembership[]
  createdByUserAccount       UserAccount?                @relation("organization_created_by", fields: [createdByUserAccountId], references: [id], onDelete: Restrict, onUpdate: NoAction)

  @@index([createdByUserAccountId], map: "organizations_created_by_idx", where: raw("(created_by_user_account_id IS NOT NULL)"))
  @@map("organizations")
}

/// A pending password reset.
///
/// The partial unique index `password_reset_one_open_token` is owned by
/// migration 0008, which also owns this table's `CHECK` constraints.
model PasswordResetToken {
  id            String      @id
  userAccountId String      @unique(map: "password_reset_one_open_token", where: raw("(consumed_at IS NULL)")) @map("user_account_id")
  tokenHash     String      @unique(map: "password_reset_tokens_token_hash_key") @map("token_hash")
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  consumedAt    DateTime?   @map("consumed_at") @db.Timestamptz(6)
  createdAt     DateTime    @map("created_at") @db.Timestamptz(6)
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@index([userAccountId], map: "password_reset_tokens_user_account_id")
  @@map("password_reset_tokens")
}

/// A refresh-token family member, rotated on every use.
///
/// `CHECK` constraints are owned by migration 0007.
model RefreshToken {
  id            String      @id
  familyId      String      @map("family_id")
  userAccountId String      @map("user_account_id")
  tokenHash     String      @unique(map: "refresh_tokens_token_hash_key") @map("token_hash")
  issuedAt      DateTime    @map("issued_at") @db.Timestamptz(6)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  usedAt        DateTime?   @map("used_at") @db.Timestamptz(6)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(6)
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@index([familyId], map: "refresh_tokens_family_id")
  @@index([userAccountId], map: "refresh_tokens_user_account_id")
  @@map("refresh_tokens")
}

/// One Sandbox dispatch reservation; the advisory lock on this table's month
/// serialises the budget.
///
/// The partial index `sandbox_dispatch_reservations_month_idx` and this table's
/// `CHECK` constraints are owned by migration 0023.
model SandboxDispatchReservation {
  requestId      String   @id @map("request_id")
  organizationId String   @map("organization_id")
  monthStart     DateTime @map("month_start") @db.Date
  status         String   @default("reserved")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  releasedAt     DateTime? @map("released_at") @db.Timestamptz(6)

  @@index([monthStart, organizationId], map: "sandbox_dispatch_reservations_month_idx", where: raw("(status = 'reserved'::text)"))
  @@map("sandbox_dispatch_reservations")
}

/// An accepted Speaking audio upload.
///
/// `CHECK` constraints are owned by migration 0025.
model SpeakingAudioAsset {
  id                   String   @id
  organizationId       String   @map("organization_id")
  endUserId            String   @map("end_user_id")
  environment          String
  objectKey            String   @unique(map: "speaking_audio_assets_object_key_key") @map("object_key")
  contentType          String   @map("content_type")
  byteSize             Int      @map("byte_size")
  acceptedAt           DateTime @map("accepted_at") @db.Timestamptz(6)
  retentionExpiresAt   DateTime @map("retention_expires_at") @db.Timestamptz(6)

  @@index([retentionExpiresAt, id], map: "speaking_audio_assets_retention_idx")
  @@map("speaking_audio_assets")
}

/// An in-progress Speaking audio upload, swept when it expires.
///
/// The partial indexes `speaking_audio_upload_intents_expiry_idx` and
/// `speaking_audio_upload_intents_rejected_idx`, and this table's `CHECK`
/// constraints, are owned by migration 0025.
model SpeakingAudioUploadIntent {
  id             String   @id
  organizationId String   @map("organization_id")
  endUserId      String   @map("end_user_id")
  environment    String
  objectKey      String   @unique(map: "speaking_audio_upload_intents_object_key_key") @map("object_key")
  contentType    String   @map("content_type")
  byteSize       Int      @map("byte_size")
  status         String   @default("open")
  createdAt      DateTime @map("created_at") @db.Timestamptz(6)
  expiresAt      DateTime @map("expires_at") @db.Timestamptz(6)

  @@index([expiresAt, createdAt], map: "speaking_audio_upload_intents_expiry_idx", where: raw("(status = 'open'::text)"))
  @@index([createdAt], map: "speaking_audio_upload_intents_rejected_idx", where: raw("(status = 'rejected'::text)"))
  @@map("speaking_audio_upload_intents")
}

/// The durable per-request usage record.
///
/// `CHECK` constraints are owned by migration 0005. The BRIN index
/// `usage_created_brin` is declared below under Prisma's `Brin` type; it was
/// created by that same migration.
model UsageRecord {
  requestId        String   @id @map("request_id")
  organizationId   String   @map("organization_id")
  apiKeyId         String   @map("api_key_id")
  actorId          String?  @map("actor_id")
  service          String
  operation        String
  environment      String
  outcome          String
  httpStatus       Int      @map("http_status")
  errorCode        String?  @map("error_code")
  billableRequests Int      @default(0) @map("billable_requests")
  inputTokens      Int?     @map("input_tokens")
  outputTokens     Int?     @map("output_tokens")
  totalTokens      Int?     @map("total_tokens")
  models           Json?
  meteringStatus   String   @map("metering_status")
  totalMs          Int      @map("total_ms")
  downstreamMs     Int?     @map("downstream_ms")
  aiProcessingMs   Int?     @map("ai_processing_ms")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([createdAt], map: "usage_created_brin", type: Brin)
  @@index([organizationId, createdAt(sort: Desc)], map: "usage_org_time_idx")
  @@map("usage_records")
}

/// A person. Every identity record is scoped by its id.
///
/// `CHECK` constraints on id, username, and status are owned by migration 0006.
model UserAccount {
  id                String                      @id
  username          String                      @unique(map: "user_accounts_username_key")
  status            String
  createdAt         DateTime                    @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                    @map("updated_at") @db.Timestamptz(6)
  authIdentities    AuthIdentity[]
  createdOrganizations Organization[]            @relation("organization_created_by")
  auditEvents       OrganizationAuditEvent[]
  emailVerificationTokens EmailVerificationToken?
  invitations       OrganizationInvitation[]
  memberships       OrganizationMembership[]
  passwordResetTokens PasswordResetToken?
  refreshTokens     RefreshToken[]
  avatar            UserAvatar?
  mfaFactor         UserMfaFactor?
  mfaRecoveryCodes  UserMfaRecoveryCode[]
  webSessions       WebSession[]

  @@map("user_accounts")
}

/// A stored Avatar, one per account.
///
/// `CHECK` constraints are owned by migration 0024.
model UserAvatar {
  id            String      @id
  userAccountId String      @unique(map: "user_avatars_one_per_account") @map("user_account_id")
  objectKey     String      @unique(map: "user_avatars_object_key_key") @map("object_key")
  contentType   String      @map("content_type")
  byteSize      Int         @map("byte_size")
  acceptedAt    DateTime    @map("accepted_at") @db.Timestamptz(6)
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@map("user_avatars")
}

/// A TOTP second factor.
///
/// `CHECK` constraints are owned by migration 0034.
model UserMfaFactor {
  factorId         String      @id @map("factor_id")
  userAccountId    String      @unique(map: "user_mfa_factors_user_account_id_key") @map("user_account_id")
  secretKeyId      String      @map("secret_key_id")
  secretCiphertext String      @map("secret_ciphertext")
  status           String
  createdAt        DateTime    @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime    @map("updated_at") @db.Timestamptz(6)
  userAccount      UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@map("user_mfa_factors")
}

/// A single-use MFA recovery code.
///
/// `CHECK` constraints are owned by migration 0034.
model UserMfaRecoveryCode {
  userAccountId String      @map("user_account_id")
  codeHash      String      @map("code_hash")
  createdAt     DateTime    @map("created_at") @db.Timestamptz(6)
  consumedAt    DateTime?   @map("consumed_at") @db.Timestamptz(6)
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@id([userAccountId, codeHash])
  @@map("user_mfa_recovery_codes")
}

/// A browser session cookie's server-side record.
///
/// `CHECK` constraints are owned by migration 0033.
model WebSession {
  id            String      @id
  userAccountId String      @map("user_account_id")
  tokenHash     String      @unique(map: "web_sessions_token_hash_key") @map("token_hash")
  createdAt     DateTime    @map("created_at") @db.Timestamptz(6)
  expiresAt     DateTime    @map("expires_at") @db.Timestamptz(6)
  lastRenewedAt DateTime    @map("last_renewed_at") @db.Timestamptz(6)
  revokedAt     DateTime?   @map("revoked_at") @db.Timestamptz(6)
  userAccount   UserAccount @relation(fields: [userAccountId], references: [id], onUpdate: NoAction)

  @@index([userAccountId], map: "web_sessions_user_account_id")
  @@map("web_sessions")
}