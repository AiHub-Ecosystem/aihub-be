{
  "$schema": "https://json.schemastore.org/tsconfig",
  "compilerOptions": {
    "module": "preserve",
    "moduleDetection": "force",
    "target": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["es2024", "ESNext.Array", "ESNext.Collection", "ESNext.Iterator"],
    "paths": {
      "@/*": ["./src/*"],
      "@prisma-client/*": ["./dist/generated/prisma/*"],
      "@kysely-types/*": ["./dist/generated/kysely/*"]
    },
    "rootDir": ".",
    "outDir": "dist",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    // #1775: an index-signature read must be spelled out in brackets, so a
    // misspelled key on a JSON document, a row shape or an env map fails the
    // type check instead of silently reading undefined.
    "noPropertyAccessFromIndexSignature": true,
    "exactOptionalPropertyTypes": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": false,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "types": ["node", "jest"],
    // #567's split Auth specs left TS6133 findings; keep these guards on and clear the bindings.
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "allowUnreachableCode": false,
    "allowUnusedLabels": false,
    "incremental": true,
    "tsBuildInfoFile": "./node_modules/.cache/typescript/tsconfig.tsbuildinfo"
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts",
    "scripts/**/*.ts",
    "prisma/seed.ts"
  ],
  "exclude": ["node_modules", "dist", "coverage", "temp"]
}
