<mjml lang="vi" dir="ltr">
  <mj-head>
    <mj-attributes>
      <mj-all font-family="Arial, Helvetica, sans-serif" />
      <mj-text color="#475467" font-size="16px" line-height="1.6" />
      <mj-button
        align="left"
        background-color="#3a64fa"
        border-radius="8px"
        color="#ffffff"
        font-size="16px"
        font-weight="700"
        inner-padding="14px 24px"
        line-height="1.4"
        text-decoration="none"
      />
    </mj-attributes>
  </mj-head>
  <mj-body background-color="#f1f5f9" width="600px">
    <mj-section padding="32px 16px">
      <mj-column
        background-color="#ffffff"
        border="1px solid #e4e7ec"
        border-radius="16px"
        padding="36px"
      >
        <mj-text
          color="#3a64fa"
          font-size="12px"
          font-weight="700"
          letter-spacing="2px"
          padding="0 0 12px"
        >AIHUB CONSOLE</mj-text>
        <mj-text
          color="#1d2838"
          padding="0 0 20px"
        ><h1 style="margin:0;font-size:28px;font-weight:700;line-height:1.25">{{title}}</h1></mj-text>
        <mj-text color="#1d2838" padding="0 0 12px">Chào bạn,</mj-text>
        <mj-text padding="0 0 24px">{{introduction}}</mj-text>
        <mj-button href="{{url}}">{{buttonLabel}}</mj-button>
        <mj-text font-size="14px" padding="0 0 16px">
          {{expiryLabel}} <strong style="color:#1d2838">{{expiresAt}}</strong> (giờ Việt Nam).
        </mj-text>
        <mj-text font-size="14px" padding="0 0 12px">{{notice}}</mj-text>
        <mj-text font-size="14px" padding="0 0 12px">{{closing}}</mj-text>
        <mj-divider border-color="#e4e7ec" border-width="1px" padding="16px 0" />
        <mj-text color="#667084" font-size="12px" padding="0">AIHUB Console</mj-text>
      </mj-column>
    </mj-section>
  </mj-body>
</mjml>
