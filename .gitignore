node_modules/
dist/
coverage/
# Stray compiled output if a watch-mode build ever emits scripts/*.ts in place
# instead of into dist/ (tsconfig.build.json now excludes scripts/ from the
# build, but this stays as a backstop).
scripts/*.js
.env
.env.*
!.env.example
!.env.production.example
# Vault Agent-rendered runtime secrets; keep the deployment destination outside
# the repository whenever possible.
runtime-secrets.json
*.runtime-secrets.json
.claude/settings.local.json
.DS_Store
Thumbs.db
.idea/
.vscode/

# Assertion signing material (scripts/dev-sign-assertion.mjs). Broad on purpose:
# a real organization's signing key copied into the repo root must never become
# committable because its filename happened not to be listed here.
*.pem
demo-jwks.json

# pnpm store created by containerized verify runs (keep out of the repo)
.pnpm-store/
