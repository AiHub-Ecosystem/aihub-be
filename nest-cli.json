{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "src",
  "compilerOptions": {
    "deleteOutDir": false,
    "tsConfigPath": "tsconfig.build.json",
    "builder": {
      "type": "swc",
      "options": {
        "stripLeadingPaths": true,
        "ignore": ["**/*.spec.ts", "src/modules/*/testing/**"]
      }
    }
  }
}
