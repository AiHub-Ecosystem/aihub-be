# Copy to .env.production on the VPS and chmod 600. Never commit the copy.
AIHUB_IMAGE=ghcr.io/replace-owner/aihub-be:replace-with-release
AIHUB_PRODUCTION_HOST=api.example.com
AIHUB_USER_ACCESS_ISSUER=https://api.example.com
# Optional public tiers; leave blank when this deployment does not serve them.
AIHUB_STAGING_HOST=
AIHUB_DEVELOPMENT_HOST=
AIHUB_SANDBOX_HOST=
# Optional sandbox assertion minting; keep the rendered deployment file mode 600.
AIHUB_SANDBOX_ORG_IDS=
AIHUB_SANDBOX_ASSERTION_PRIVATE_KEY=
AIHUB_SANDBOX_ASSERTION_KID=
# Required only when this deployment serves sandbox through the isolated stack.
AIHUB_SANDBOX_APP_PORT=3022
AIHUB_SANDBOX_DATABASE_URL=
AIHUB_SANDBOX_REDIS_URL=
AIHUB_DATABASE_NETWORK=aihub_aihub-network
AIHUB_APP_PORT=3021

DATABASE_URL=postgresql://aihub_admin:replace-with-url-encoded-db-password@aihub-db:5432/aihub

# Shared Wispace Redis on the VPS; populate the password from Vault as described
# in docs/operations/deploy-vps.md. Do not commit the rendered value.
REDIS_URL=redis://:replace-with-wispace-redis-password@redis.aihubproduction.com:6379/0

DOWNSTREAM_AI_WRITING_URL=https://api-ielts-writing.aihubproduction.com
DOWNSTREAM_AI_SPEAKING_URL=https://api-ielts-speaking.aihubproduction.com

# Temporary Stage A mode until the production Vault cutover in issue #30.
# Keep this file mode 600, never commit the real values, and remove these
# long-lived credentials after switching back to the Vault Agent override.
AIHUB_RUNTIME_SECRET_SOURCE=env
AIHUB_ALLOW_PRODUCTION_ENV_SECRETS=true
DOWNSTREAM_AI_WRITING_TOKEN=replace-with-ai-writing-token
DOWNSTREAM_AI_SPEAKING_CLIENT_ID=replace-with-ai-speaking-client-id
DOWNSTREAM_AI_SPEAKING_SECRET_KEY=replace-with-ai-speaking-secret-key
RESEND_API_KEY=replace-with-resend-api-key
AIHUB_USER_ACCESS_JWT_PRIVATE_KEY=replace-with-rsa-pkcs8-private-key
AIHUB_USER_ACCESS_JWT_KID=replace-with-active-key-id
RESEND_FROM=no-reply@example.com
# Required for the public Speaking sample-audio endpoint when using env secrets.
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=
SEAWEEDFS_ENDPOINT_URL=https://s3.wispace.app
SEAWEEDFS_BUCKET=aihub-speaking-samples
SEAWEEDFS_REGION=us-east-1

VAULT_IMAGE=hashicorp/vault:1.21.4
# Retained for the future Vault Agent mode; not used by the temporary env override.
VAULT_ADDR=https://vault.example.com:8200
VAULT_CA_CERT_FILE=/srv/aihub/secrets/vault-ca.pem
VAULT_ROLE_ID_FILE=/srv/aihub/secrets/vault-role-id
VAULT_SECRET_ID_FILE=/srv/aihub/secrets/vault-secret-id
AIHUB_RUNTIME_SECRETS_HOST_DIR=/srv/aihub/secrets/runtime
