# Copy to .env.production on the VPS and chmod 600. Never commit the copy.
AIHUB_IMAGE=ghcr.io/replace-owner/aihub-be:replace-with-release
AIHUB_PRODUCTION_HOST=api.example.com
AIHUB_USER_ACCESS_ISSUER=https://api.example.com
# Optional public tiers; leave blank when this deployment does not serve them.
AIHUB_STAGING_HOST=
AIHUB_DEVELOPMENT_HOST=
AIHUB_SANDBOX_HOST=
# Set true only when the isolated sandbox database/Redis bundles are provisioned.
AIHUB_SANDBOX_ENABLED=false
AIHUB_SANDBOX_ORG_IDS=
# The sandbox connection URLs and signing material are Vault bundles.
AIHUB_SANDBOX_APP_PORT=3022
AIHUB_DATABASE_NETWORK=aihub_aihub-network
AIHUB_APP_PORT=3021

DOWNSTREAM_AI_WRITING_URL=https://api-ielts-writing.aihubproduction.com
DOWNSTREAM_AI_SPEAKING_URL=https://api-ielts-speaking.aihubproduction.com

# Runtime credentials, database/Redis URLs, the sandbox control-plane reader,
# and sandbox signing material are rendered by Vault Agent. The application
# reads these files at startup.
AIHUB_RUNTIME_SECRET_SOURCE=agent-file
AIHUB_RUNTIME_CONNECTION_SECRETS_FILE=/run/secrets/aihub/connection-secrets.json
RESEND_FROM=no-reply@example.com
# Required HTTPS Customer Web deployment URL, optionally with a path prefix.
CUSTOMER_WEB_BASE_URL=https://customer.example.com
# Optional HTTPS URL for a separately deployed sandbox Customer Web.
# Leave blank for the API-only sandbox; its emails remain token-only.
CUSTOMER_WEB_SANDBOX_BASE_URL=
SEAWEEDFS_ENDPOINT_URL=https://s3.wispace.app
SEAWEEDFS_BUCKET=aihub-speaking-samples
SEAWEEDFS_REGION=us-east-1

VAULT_IMAGE=hashicorp/vault:1.21.4
VAULT_ADDR=https://vault.example.com:8200
VAULT_CA_CERT_FILE=/srv/aihub/secrets/vault-ca.pem
VAULT_ROLE_ID_FILE=/srv/aihub/secrets/vault-role-id
VAULT_SECRET_ID_FILE=/srv/aihub/secrets/vault-secret-id
AIHUB_RUNTIME_SECRETS_HOST_DIR=/srv/aihub/secrets/runtime

# Optional OpenTelemetry OTLP/HTTP trace receiver reachable from the app network.
# Example: http://otel-collector:4318/v1/traces. Blank disables tracing.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=aihub-be
