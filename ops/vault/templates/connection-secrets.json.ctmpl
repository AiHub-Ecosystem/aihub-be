{{- $environment := env "AIHUB_VAULT_ENVIRONMENT" -}}
{
  "database": {
    {{- with secret (printf "secret/data/aihub/%s/database" $environment) -}}
    "url": {{ toJSON .Data.data.url }},
    "sandbox_url": {{ toJSON .Data.data.sandbox_url }},
    "sandbox_control_plane_read_url": {{ toJSON .Data.data.sandbox_control_plane_read_url }},
    "email_send_budget_url": {{ toJSON .Data.data.email_send_budget_url }},
    "email_wal_url": {{ toJSON .Data.data.email_wal_url }},
    "sandbox_email_wal_url": {{ toJSON .Data.data.sandbox_email_wal_url }},
    "pooler_url": {{ toJSON .Data.data.pooler_url }},
    "sandbox_pooler_url": {{ toJSON .Data.data.sandbox_pooler_url }},
    "control_plane_pooler_url": {{ toJSON .Data.data.control_plane_pooler_url }},
    "sandbox_control_plane_pooler_url": {{ toJSON .Data.data.sandbox_control_plane_pooler_url }},
    "control_plane_read_pooler_url": {{ toJSON .Data.data.control_plane_read_pooler_url }},
    "sandbox_control_plane_read_pooler_url": {{ toJSON .Data.data.sandbox_control_plane_read_pooler_url }},
    "email_send_budget_pooler_url": {{ toJSON .Data.data.email_send_budget_pooler_url }},
    "sandbox_email_send_budget_pooler_url": {{ toJSON .Data.data.sandbox_email_send_budget_pooler_url }}
    {{- end }}
  },
  "redis": {
    {{- with secret (printf "secret/data/aihub/%s/redis" $environment) -}}
    "url": {{ toJSON .Data.data.url }},
    "sandbox_url": {{ toJSON .Data.data.sandbox_url }},
    "email_send_rate_url": {{ toJSON .Data.data.email_send_rate_url }}
    {{- end }}
  },
  "sandbox-assertion": {
    {{- with secret (printf "secret/data/aihub/%s/sandbox-assertion" $environment) -}}
    "private_key_pem": {{ toJSON .Data.data.private_key_pem }},
    "key_id": {{ toJSON .Data.data.key_id }}
    {{- end }}
  }
}
