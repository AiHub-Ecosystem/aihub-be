{{- $environment := env "AIHUB_VAULT_ENVIRONMENT" -}}
{
  "ai-speaking": {
    {{- with secret (printf "secret/data/aihub/%s/ai-speaking" $environment) -}}
    "client_id": {{ toJSON .Data.data.client_id }},
    "secret_key": {{ toJSON .Data.data.secret_key }}
    {{- end -}}
  },
  "ai-writing": {
    {{- with secret (printf "secret/data/aihub/%s/ai-writing" $environment) -}}
    "token": {{ toJSON .Data.data.token }}
    {{- end -}}
  },
  "resend": {
    {{- with secret (printf "secret/data/aihub/%s/resend" $environment) -}}
    "api_key": {{ toJSON .Data.data.api_key }}
    {{- end -}}
  },
  "user-access-jwt": {
    {{- with secret (printf "secret/data/aihub/%s/user-access-jwt" $environment) -}}
    "private_key_pem": {{ toJSON .Data.data.private_key_pem }},
    "key_id": {{ toJSON .Data.data.key_id }}
    {{- end -}}
  },
  "seaweedfs": {
    {{- with secret (printf "secret/data/aihub/%s/seaweedfs" $environment) -}}
    "access_key_id": {{ toJSON .Data.data.access_key_id }},
    "secret_access_key": {{ toJSON .Data.data.secret_access_key }}
    {{- end -}}
  },
  "email-outbox": {
    {{- with secret (printf "secret/data/aihub/%s/email-outbox" $environment) -}}
    "current_key_id": {{ toJSON .Data.data.current_key_id }},
    "keys": {{ .Data.data.keys }}
    {{- end -}}
  }
}
