{{- $environment := env "AIHUB_VAULT_ENVIRONMENT" -}}
{
  "ai-speaking": {
    {{- with secret (printf "secret/data/aihub/%s/ai-speaking" $environment) -}}
    "client_id": {{ toJSON .Data.data.client_id }},
    "secret_key": {{ toJSON .Data.data.secret_key }}
    {{- end -}}
  },
  "ai-writing": {
    {{- with secret (printf "secret/data/aihub/%s/ai-writing" $environment) -}}
    "token": {{ toJSON .Data.data.token }}
    {{- end -}}
  }
}
