{{ $environment := env "AIHUB_VAULT_ENVIRONMENT" }}
{{ with secret (printf "secret/data/aihub/%s/database-pooler" $environment) }}
{{ range $alias, $database := .Data.data.databases }}
{{ range $user := $database.users }}
{{ toJSON $user.username }} {{ toJSON $user.password }}
{{ end }}
{{ end }}
"aihub_pgbouncer_admin" {{ toJSON .Data.data.admin_password }}
"aihub_pgbouncer_metrics" {{ toJSON .Data.data.stats_password }}
{{ end }}
