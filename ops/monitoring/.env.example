# Copy outside the repository; use the host-specific values in the runbook.
# Production uses 127.0.0.1. Monitoring uses its observed Docker bridge gateway.
AIHUB_METRICS_BIND_IP=127.0.0.1

# Production host only. The exporter role executes one aggregate-only function.
AIHUB_PRODUCTION_UID_GID=1000:1000
AIHUB_POSTGRES_EXPORTER_URI=127.0.0.1:5433/aihub?sslmode=disable
AIHUB_POSTGRES_EXPORTER_USER=aihub_monitoring
AIHUB_POSTGRES_EXPORTER_PASSWORD_FILE=/etc/aihub-monitoring/secrets/postgres-exporter-password

# Monitoring host only. Redis is reached over the existing private Docker network.
AIHUB_REDIS_EXPORTER_ADDRESS=redis://redis:6379
AIHUB_REDIS_EXPORTER_USER=aihub_exporter
AIHUB_REDIS_EXPORTER_PASSWORD_FILE=/etc/aihub-monitoring/secrets/redis-exporter-password
AIHUB_MONITORING_GATEWAY=172.27.0.1
AIHUB_MONITORING_UID_GID=1004:1004
AIHUB_TUNNEL_USER=replace-with-restricted-ssh-user
AIHUB_PRODUCTION_HOST=<production-host>
AIHUB_MONITORING_SSH_KEY_FILE=/etc/aihub-monitoring/secrets/id_ed25519
AIHUB_MONITORING_KNOWN_HOSTS_FILE=/etc/aihub-monitoring/secrets/known_hosts
