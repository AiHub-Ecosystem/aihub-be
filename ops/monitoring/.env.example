# Copy outside the repository and set values for the host running this project.
# Metrics listeners must use a non-public address reachable only by Prometheus.
AIHUB_METRICS_BIND_IP=127.0.0.1

# Production host only. This role and its grants are gated by #298.
AIHUB_POSTGRES_EXPORTER_URI=127.0.0.1:5433/aihub?sslmode=disable
AIHUB_POSTGRES_EXPORTER_USER=replace-with-approved-monitoring-role
AIHUB_POSTGRES_EXPORTER_PASSWORD_FILE=/etc/aihub-monitoring/secrets/postgres-exporter-password

# Monitoring host only. Set the Redis endpoint after checking the deployed topology.
AIHUB_REDIS_EXPORTER_ADDRESS=redis://127.0.0.1:6379
AIHUB_REDIS_EXPORTER_PASSWORD_FILE=/etc/aihub-monitoring/secrets/redis-exporter-password
