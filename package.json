{
  "name": "aihub-be",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.4.4",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "node scripts/generate/compile-auth-email-template.mjs && node scripts/generate/clean-dist.cjs && nest build && node scripts/generate/generate-prisma-client.mjs --runtime",
    "generate:prisma-client": "node scripts/generate/generate-prisma-client.mjs",
    "generate:migration": "node scripts/generate/generate-migration.mjs",
    "dev": "node scripts/generate/generate-prisma-client.mjs --runtime && node scripts/runtime/dev-runner.mjs",
    "start": "node dist/main.js",
    "migrate": "node scripts/cli/migrate.mjs",
    "db:seed": "bun run generate:prisma-client && prisma db seed",
    "cli": "node scripts/cli/cli.mjs",
    "dev:assertion": "node scripts/cli/dev-sign-assertion.mjs",
    "demo:bootstrap": "node scripts/cli/demo-bootstrap.mjs",
    "check:api-compatibility": "node scripts/ci/api-compatibility/check-release.mjs",
    "test:api-compatibility": "node --test --test-concurrency=1 test/cli/api-compatibility/api-compatibility-check.spec.mjs test/cli/api-compatibility/api-compatibility-release.spec.mjs",
    "benchmark:dev-restart": "node scripts/ops/dev-restart-benchmark/benchmark.mjs",
    "generate:openapi": "bun scripts/generate/generate-openapi.ts && biome format --write openapi.json openapi",
    "validate:openapi": "node scripts/checks/validate-openapi.mjs",
    "generate:postman": "bun scripts/generate/generate-postman.ts && biome format --write aihub.postman_collection.json",
    "canary:ai-writing": "tsx scripts/ops/canary/canary-ai-writing.ts",
    "capacity:benchmark": "node scripts/ops/capacity-benchmark/capacity-benchmark.mjs",
    "benchmark:postgres-plans": "tsx scripts/ops/postgres-query-plan-baseline/run.ts",
    "test:capacity-benchmark": "node --test scripts/ops/capacity-benchmark/capacity-benchmark.spec.mjs",
    "test:zero-table-outbox-run": "node --test scripts/ops/zero-table-outbox-run/runner.spec.mjs",
    "outbox:evaluate": "node scripts/ops/zero-table-outbox-run/runner.mjs",
    "test:monitoring-config": "node --test scripts/ops/monitoring/check-monitoring-config.spec.cjs scripts/ops/monitoring/update-alert-rules-fingerprint.spec.mjs",
    "check:monitoring-config": "node scripts/ops/monitoring/check-monitoring-config.cjs",
    "benchmark:control-plane": "node scripts/ops/capacity-benchmark/benchmark-control-plane.mjs",
    "benchmark:kysely-spike": "bun run build && node scripts/ops/kysely-evaluation/benchmark.mjs",
    "benchmark:kysely-database": "bun run build && node scripts/ops/kysely-evaluation/benchmark-database.mjs",
    "measure:public-api-major-usage-buffer": "node --expose-gc scripts/ops/capacity-benchmark/measure-public-api-major-usage-buffer.mjs",
    "vault:provision": "node ops/vault/provision-runtime-secrets.mjs",
    "vault:smoke": "node scripts/ops/vault/vault-smoke.mjs",
    "test": "node scripts/generate/generate-prisma-client.mjs --runtime && node scripts/cli/run-bun-test.mjs",
    "test:db": "node scripts/checks/db-lane/run-database-lane.cjs db",
    "test:tenant-isolation": "node scripts/checks/db-lane/run-database-lane.cjs tenant-isolation",
    "coverage:unit": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --coverage --coverageReporters=json --coverageDirectory=coverage/unit",
    "coverage:db": "node scripts/checks/db-lane/run-database-lane.cjs db --coverage --coverageReporters=json --coverageDirectory=coverage/db",
    "coverage:tenant-isolation": "node scripts/checks/db-lane/run-database-lane.cjs tenant-isolation --coverage --coverageReporters=json --coverageDirectory=coverage/tenant-isolation",
    "coverage:merged": "node scripts/checks/changed/merged-coverage.cjs",
    "test:watch": "bun run test -- --watch",
    "type-check": "node scripts/generate/generate-prisma-client.mjs && tsc --noEmit",
    "type-check:scripts": "tsc -p tsconfig.scripts.json",
    "format": "biome format --write .",
    "lint": "node scripts/generate/generate-prisma-client.mjs && oxlint . && biome check .",
    "format:check": "prettier --check --cache \"**/*.{md,yaml,yml}\"",
    "arch-check": "node scripts/checks/architecture/check-architecture.mjs",
    "check:app-errors": "bun scripts/checks/data/check-app-errors.ts",
    "check:imports": "bun scripts/checks/structure/check-import-style.ts",
    "check:imports:dist": "bun scripts/checks/structure/check-import-style.ts --dist",
    "check:migrations": "squawk --no-error-on-unmatched-pattern \"prisma/migrations/*/migration.sql\"",
    "check:prisma-drift": "node scripts/checks/prisma-drift/check-prisma-drift.mjs",
    "check:issue-triage": "node scripts/checks/hooks/check-issue-triage.mjs",
    "test:issue-triage": "node --test scripts/checks/hooks/check-issue-triage.spec.mjs scripts/checks/hooks/issue-triage-hook.spec.mjs",
    "test:lint-staged": "node --test scripts/checks/hooks/lint-staged-config.spec.mjs",
    "test:commit-message": "jest --runTestsByPath scripts/checks/hooks/commit-message.spec.ts",
    "test:format-check": "node --test scripts/checks/changed/format-check-cache.spec.mjs",
    "check:doc-drift": "node scripts/checks/doc-drift/check-doc-drift.mjs",
    "test:doc-drift": "node --test scripts/checks/doc-drift/check-doc-drift.spec.mjs",
    "knip": "bun run generate:prisma-client && node scripts/checks/knip/knip.mjs",
    "verify:summary": "node scripts/checks/changed/verify-summary.cjs",
    "provider:refresh": "node scripts/generate/refresh-provider-contract.mjs",
    "verify": "bun run knip && bun run lint && bun run format:check && bun run type-check && bun run arch-check && bun run check:app-errors && bun run check:batch && bun run check:nginx-headers && bun run check:folder-entries && bun run test && bun run test:monitoring-config && bun run build && bun run type-check:scripts && bun run check:imports:dist",
    "prepare": "husky",
    "generate:data-dictionary": "bun scripts/generate/generate-data-dictionary.ts",
    "check:data-dictionary": "node scripts/checks/data/check-data-dictionary.mjs",
    "check:tenant-global": "node scripts/checks/data/check-tenant-global.mjs",
    "check:data-ownership": "node scripts/checks/data/check-data-ownership.mjs",
    "check:file-size": "node scripts/checks/structure/check-file-size.mjs",
    "check:folder-entries": "node scripts/checks/structure/check-folder-entries.mjs",
    "check:nginx-headers": "node scripts/checks/check-nginx-headers.mjs",
    "check:compose": "AIHUB_EMAIL_SEND_RATE_LIMIT=1 AIHUB_EMAIL_SEND_RATE_DURATION_MS=1000 AIHUB_EMAIL_DAILY_SEND_BUDGET=80 docker compose --profile \"*\" --env-file .env.production.example -f docker-compose.production.yml config --format json | node scripts/ci/compose/check-production-compose-logs.cjs && AIHUB_EMAIL_SEND_RATE_LIMIT=1 AIHUB_EMAIL_SEND_RATE_DURATION_MS=1000 AIHUB_EMAIL_DAILY_SEND_BUDGET=80 docker compose --profile \"*\" --env-file .env.production.example -f docker-compose.production.yml config --format json | node scripts/ci/compose/check-trusted-proxy-compose.cjs",
    "check:deprecation": "bun scripts/checks/structure/check-deprecation.ts",
    "ci:check-n-minus-one": "tsx scripts/ci/n-minus-one/n-minus-one-compatibility.ts",
    "ci:n-minus-one-stubs": "node scripts/ci/n-minus-one/n-minus-one-stubs.mjs",
    "check:domain-globals": "node scripts/checks/data/check-domain-globals.mjs",
    "test:related": "bun run test -- --changed=origin/main",
    "test:jest-specs": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --coverage=false --passWithNoTests --runTestsByPath",
    "check:changed": "node scripts/checks/changed/check-changed.mjs",
    "check:batch": "node scripts/checks/changed/check-batch.cjs",
    "test:check-app-errors": "jest --runTestsByPath scripts/checks/data/check-app-errors.spec.ts",
    "test:check-changed": "node --test scripts/checks/changed/check-changed.spec.mjs",
    "test:secret-scan": "node --test scripts/ci/secret-scan/secret-scan-plan.spec.mjs",
    "test:shell-specs": "node scripts/checks/changed/run-shell-specs.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1163.0",
    "@aws-sdk/s3-presigned-post": "^3.1163.0",
    "@aws-sdk/s3-request-presigner": "^3.1163.0",
    "@fastify/cookie": "^11.1.5",
    "@fastify/multipart": "10.1.7",
    "@nestjs/common": "^12.3.2",
    "@nestjs/config": "12.1.0",
    "@nestjs/core": "^12.3.2",
    "@nestjs/cqrs": "^12.1.2",
    "@nestjs/platform-fastify": "^12.3.2",
    "@nestjs/terminus": "12.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.14",
    "nestjs-pino": "^5.3.1",
    "opossum": "10.0.0",
    "pg": "^8.23.1",
    "pg-logical-replication": "^2.6.0",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "ulid": "^3.0.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^12.0.11",
    "@nestjs/testing": "^12.3.2",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@swc/cli": "^0.8.2",
    "@swc/core": "1.16.22",
    "@swc/jest": "^0.2.39",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/opossum": "8.1.9",
    "@types/pg": "^8.23.1",
    "@types/postman-collection": "^3.5.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^29.7.0",
    "knip": "^6.44.1",
    "kysely": "0.29.8",
    "lint-staged": "^17.6.0",
    "mjml": "^5.4.1",
    "openapi-to-postmanv2": "^6.4.2",
    "oxlint": "^1.90.0",
    "oxlint-tsgolint": "7.0.2006",
    "postman-collection": "^5.3.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "prisma-kysely": "3.2.1",
    "squawk-cli": "2.70.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  },
  "overrides": {
    "js-yaml@>=4.0.0 <4.3.2": "^4.3.2",
    "yaml@>=1.0.0 <1.10.3": "^1.10.3",
    "uuid@<11.1.1": "^11.1.1",
    "brace-expansion@<1.1.21": "^1.1.21"
  },
  "trustedDependencies": [
    "@biomejs/biome",
    "@prisma/engines",
    "@swc/core",
    "argon2",
    "esbuild",
    "prisma"
  ]
}
