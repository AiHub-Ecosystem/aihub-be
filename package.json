{
  "name": "aihub-be",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "migrate:sandbox-control-plane": "node scripts/sandbox-control-plane-migration.cjs",
    "migrate:cw": "node scripts/customer-web-migration.cjs",
    "cli": "node scripts/cli.mjs",
    "dev:assertion": "node scripts/dev-sign-assertion.mjs",
    "demo:bootstrap": "node scripts/demo-bootstrap.mjs",
    "generate:openapi": "tsx scripts/generate-openapi.ts && biome format --write openapi.json",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "generate:postman": "tsx scripts/generate-postman.ts && biome format --write aihub.postman_collection.json",
    "canary:ai-writing": "tsx scripts/canary-ai-writing.ts",
    "vault:provision": "node ops/vault/provision-runtime-secrets.mjs",
    "vault:smoke": "node scripts/vault-smoke.mjs",
    "test": "jest",
    "test:db": "jest --config jest.config.db.cjs --runInBand",
    "test:tenant-isolation": "jest --config jest.config.tenant-isolation.cjs --runInBand",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "type-check:tsgo": "tsgo --noEmit",
    "format": "biome format --write .",
    "lint": "oxlint . && biome check .",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\"",
    "arch-check": "node scripts/check-architecture.mjs",
    "check:imports": "tsx scripts/check-import-style.ts",
    "check:imports:dist": "tsx scripts/check-import-style.ts --dist",
    "check:migrations": "node scripts/check-migrations.mjs",
    "knip": "node scripts/knip.mjs",
    "verify:summary": "node scripts/verify-summary.cjs",
    "provider:refresh": "node scripts/refresh-provider-contract.mjs",
    "verify": "pnpm knip && pnpm lint && pnpm format:check && pnpm type-check && pnpm test && pnpm build && pnpm check:imports:dist && pnpm check:migrations && pnpm arch-check && pnpm check:imports && pnpm validate:openapi",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/multipart": "10.1.1",
    "@nestjs/common": "^12.0.4",
    "@nestjs/core": "^12.0.4",
    "@nestjs/platform-fastify": "^12.0.4",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.11.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.222.0",
    "@opentelemetry/instrumentation-ioredis": "^0.70.0",
    "@opentelemetry/instrumentation-pg": "^0.74.0",
    "@opentelemetry/instrumentation-undici": "^0.32.0",
    "@opentelemetry/sdk-node": "^0.222.0",
    "@opentelemetry/sdk-trace-base": "^2.11.0",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.41.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^12.0.3",
    "@nestjs/testing": "^12.0.4",
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/postman-collection": "^3.5.11",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dependency-cruiser": "^17.3.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "knip": "^6.37.0",
    "lint-staged": "^17.5.0",
    "openapi-to-postmanv2": "^6.3.3",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "7.0.2002",
    "postman-collection": "^5.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
