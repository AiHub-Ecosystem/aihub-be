{
  "name": "aihub-be",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && nest build && node scripts/generate/generate-prisma-client.mjs --runtime",
    "generate:prisma-client": "node scripts/generate/generate-prisma-client.mjs",
    "generate:migration": "node scripts/generate/generate-migration.mjs",
    "dev": "node scripts/generate/generate-prisma-client.mjs --runtime && nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node scripts/cli/migrate.mjs",
    "cli": "node scripts/cli/cli.mjs",
    "dev:assertion": "node scripts/cli/dev-sign-assertion.mjs",
    "demo:bootstrap": "node scripts/cli/demo-bootstrap.mjs",
    "generate:openapi": "tsx scripts/generate/generate-openapi.ts && biome format --write openapi.json",
    "validate:openapi": "node scripts/checks/validate-openapi.mjs",
    "generate:postman": "tsx scripts/generate/generate-postman.ts && biome format --write aihub.postman_collection.json",
    "canary:ai-writing": "tsx scripts/ops/canary-ai-writing.ts",
    "capacity:benchmark": "node scripts/ops/capacity-benchmark.mjs",
    "test:capacity-benchmark": "node --test scripts/ops/capacity-benchmark.spec.mjs",
    "test:monitoring-config": "node --test scripts/ops/check-monitoring-config.spec.cjs",
    "check:monitoring-config": "node scripts/ops/check-monitoring-config.cjs",
    "benchmark:control-plane": "node scripts/ops/benchmark-control-plane.mjs",
    "vault:provision": "node ops/vault/provision-runtime-secrets.mjs",
    "vault:smoke": "node scripts/ops/vault-smoke.mjs",
    "test": "node scripts/generate/generate-prisma-client.mjs --runtime && jest",
    "test:db": "node scripts/checks/db-lane/run-database-lane.cjs db",
    "test:tenant-isolation": "node scripts/checks/db-lane/run-database-lane.cjs tenant-isolation",
    "coverage:unit": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --coverage --coverageReporters=json --coverageDirectory=coverage/unit",
    "coverage:db": "node scripts/checks/db-lane/run-database-lane.cjs db --coverage --coverageReporters=json --coverageDirectory=coverage/db",
    "coverage:tenant-isolation": "node scripts/checks/db-lane/run-database-lane.cjs tenant-isolation --coverage --coverageReporters=json --coverageDirectory=coverage/tenant-isolation",
    "coverage:merged": "node scripts/checks/merged-coverage.cjs",
    "test:watch": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --watch",
    "type-check": "node scripts/generate/generate-prisma-client.mjs && tsc --noEmit",
    "type-check:tsgo": "node scripts/generate/generate-prisma-client.mjs && tsgo --noEmit",
    "format": "biome format --write .",
    "lint": "oxlint . && biome check .",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\"",
    "arch-check": "node scripts/checks/check-architecture.mjs",
    "check:imports": "tsx scripts/checks/check-import-style.ts",
    "check:imports:dist": "tsx scripts/checks/check-import-style.ts --dist",
    "check:migrations": "node scripts/checks/check-migrations.mjs",
    "check:prisma-drift": "node scripts/checks/prisma-drift/check-prisma-drift.mjs",
    "check:issue-triage": "node scripts/checks/check-issue-triage.mjs",
    "test:issue-triage": "node --test scripts/checks/check-issue-triage.spec.mjs",
    "knip": "pnpm generate:prisma-client && node scripts/checks/knip.mjs",
    "verify:summary": "node scripts/checks/verify-summary.cjs",
    "provider:refresh": "node scripts/generate/refresh-provider-contract.mjs",
    "verify": "pnpm knip && pnpm lint && pnpm format:check && pnpm type-check && pnpm arch-check && pnpm check:imports && pnpm check:migrations && pnpm check:data-dictionary && pnpm validate:openapi && pnpm test && pnpm test:capacity-benchmark && pnpm test:monitoring-config && pnpm build && pnpm check:imports:dist",
    "prepare": "husky",
    "generate:data-dictionary": "tsx scripts/generate/generate-data-dictionary.ts",
    "check:data-dictionary": "node scripts/checks/check-data-dictionary.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-presigned-post": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "10.1.3",
    "@nestjs/common": "^12.1.3",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/terminus": "12.1.0",
    "@opentelemetry/api": "^1.9.1",
    "@opentelemetry/core": "^2.12.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.223.0",
    "@opentelemetry/instrumentation-ioredis": "^0.71.0",
    "@opentelemetry/instrumentation-pg": "^0.75.0",
    "@opentelemetry/instrumentation-undici": "^0.33.0",
    "@opentelemetry/sdk-node": "^0.223.0",
    "@opentelemetry/sdk-trace-base": "^2.12.0",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@prometheus-io/client": "0.16.1",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.45.1",
    "fastify": "^5.12.5",
    "ioredis": "^6.0.0",
    "jose": "^6.2.12",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "ulid": "^3.0.2",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/testing": "^12.1.3",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.16.18",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/postman-collection": "^3.5.11",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "dependency-cruiser": "^18.6.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^29.7.0",
    "knip": "^6.41.0",
    "lint-staged": "^17.6.0",
    "openapi-to-postmanv2": "^6.4.0",
    "oxlint": "^1.87.0",
    "oxlint-tsgolint": "7.0.2004",
    "postman-collection": "^5.3.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
