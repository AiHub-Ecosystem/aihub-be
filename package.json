{
  "name": "aihub-be",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.22.3"
  },
  "scripts": {
    "build": "node scripts/generate/compile-auth-email-template.mjs && node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && nest build && node scripts/generate/generate-prisma-client.mjs --runtime",
    "generate:prisma-client": "node scripts/generate/generate-prisma-client.mjs",
    "generate:migration": "node scripts/generate/generate-migration.mjs",
    "dev": "node scripts/generate/generate-prisma-client.mjs --runtime && nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node scripts/cli/migrate.mjs",
    "db:seed": "pnpm generate:prisma-client && prisma db seed",
    "cli": "node scripts/cli/cli.mjs",
    "dev:assertion": "node scripts/cli/dev-sign-assertion.mjs",
    "demo:bootstrap": "node scripts/cli/demo-bootstrap.mjs",
    "check:api-compatibility": "node scripts/ci/api-compatibility/check-release.mjs",
    "test:api-compatibility": "node --test test/cli/api-compatibility-check.spec.mjs test/cli/api-compatibility-release.spec.mjs",
    "generate:openapi": "tsx scripts/generate/generate-openapi.ts && biome format --write openapi.json openapi",
    "validate:openapi": "node scripts/checks/validate-openapi.mjs",
    "generate:postman": "tsx scripts/generate/generate-postman.ts && biome format --write aihub.postman_collection.json",
    "canary:ai-writing": "tsx scripts/ops/canary/canary-ai-writing.ts",
    "capacity:benchmark": "node scripts/ops/capacity-benchmark/capacity-benchmark.mjs",
    "benchmark:postgres-plans": "tsx scripts/ops/postgres-query-plan-baseline/run.ts",
    "test:capacity-benchmark": "node --test scripts/ops/capacity-benchmark/capacity-benchmark.spec.mjs",
    "test:monitoring-config": "node --test scripts/ops/monitoring/check-monitoring-config.spec.cjs scripts/ops/monitoring/update-alert-rules-fingerprint.spec.mjs",
    "check:monitoring-config": "node scripts/ops/monitoring/check-monitoring-config.cjs",
    "benchmark:control-plane": "node scripts/ops/capacity-benchmark/benchmark-control-plane.mjs",
    "vault:provision": "node ops/vault/provision-runtime-secrets.mjs",
    "vault:smoke": "node scripts/ops/vault/vault-smoke.mjs",
    "test": "node scripts/generate/generate-prisma-client.mjs --runtime && jest",
    "test:db": "node scripts/checks/db-lane/run-database-lane.cjs db",
    "test:tenant-isolation": "node scripts/checks/db-lane/run-database-lane.cjs tenant-isolation",
    "coverage:unit": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --coverage --coverageReporters=json --coverageDirectory=coverage/unit",
    "coverage:db": "node scripts/checks/db-lane/run-database-lane.cjs db --coverage --coverageReporters=json --coverageDirectory=coverage/db",
    "coverage:tenant-isolation": "node scripts/checks/db-lane/run-database-lane.cjs tenant-isolation --coverage --coverageReporters=json --coverageDirectory=coverage/tenant-isolation",
    "coverage:merged": "node scripts/checks/merged-coverage.cjs",
    "test:watch": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --watch",
    "type-check": "node scripts/generate/generate-prisma-client.mjs && tsc --noEmit",
    "format": "biome format --write .",
    "lint": "node scripts/generate/generate-prisma-client.mjs && oxlint . && biome check .",
    "format:check": "prettier --check \"**/*.{md,yaml,yml}\"",
    "arch-check": "node scripts/checks/check-architecture.mjs",
    "check:imports": "tsx scripts/checks/check-import-style.ts",
    "check:imports:dist": "tsx scripts/checks/check-import-style.ts --dist",
    "check:migrations": "squawk --no-error-on-unmatched-pattern \"prisma/migrations/*/migration.sql\"",
    "check:prisma-drift": "node scripts/checks/prisma-drift/check-prisma-drift.mjs",
    "check:issue-triage": "node scripts/checks/check-issue-triage.mjs",
    "test:issue-triage": "node --test scripts/checks/check-issue-triage.spec.mjs scripts/checks/issue-triage-hook.spec.mjs",
    "test:lint-staged": "node --test scripts/checks/lint-staged-config.spec.mjs",
    "check:doc-drift": "node scripts/checks/check-doc-drift.mjs",
    "test:doc-drift": "node --test scripts/checks/check-doc-drift.spec.mjs",
    "knip": "pnpm generate:prisma-client && node scripts/checks/knip.mjs",
    "verify:summary": "node scripts/checks/verify-summary.cjs",
    "provider:refresh": "node scripts/generate/refresh-provider-contract.mjs",
    "verify": "pnpm knip && pnpm lint && pnpm format:check && pnpm type-check && pnpm arch-check && pnpm check:batch && pnpm check:nginx-headers && pnpm test && pnpm test:monitoring-config && pnpm build && pnpm check:imports:dist",
    "prepare": "husky",
    "generate:data-dictionary": "tsx scripts/generate/generate-data-dictionary.ts",
    "check:data-dictionary": "node scripts/checks/check-data-dictionary.mjs",
    "check:tenant-global": "node scripts/checks/check-tenant-global.mjs",
    "check:data-ownership": "node scripts/checks/check-data-ownership.mjs",
    "check:file-size": "node scripts/checks/check-file-size.mjs",
    "check:nginx-headers": "node scripts/checks/check-nginx-headers.mjs",
    "check:deprecation": "tsx scripts/checks/check-deprecation.ts",
    "ci:check-n-minus-one": "tsx scripts/ci/n-minus-one/n-minus-one-compatibility.ts",
    "ci:n-minus-one-stubs": "node scripts/ci/n-minus-one/n-minus-one-stubs.mjs",
    "check:domain-globals": "node scripts/checks/check-domain-globals.mjs",
    "test:related": "node scripts/generate/generate-prisma-client.mjs --runtime && jest --findRelatedTests --passWithNoTests",
    "check:changed": "node scripts/checks/check-changed.mjs",
    "check:batch": "node scripts/checks/check-batch.cjs",
    "test:check-changed": "node --test scripts/checks/check-changed.spec.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-presigned-post": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "@fastify/cookie": "^11.1.3",
    "@fastify/multipart": "10.1.6",
    "@nestjs/common": "^12.2.0",
    "@nestjs/config": "12.0.1",
    "@nestjs/core": "^12.2.0",
    "@nestjs/platform-fastify": "^12.2.0",
    "@nestjs/terminus": "12.1.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.0.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.300.0",
    "@opentelemetry/instrumentation-ioredis": "^0.72.0",
    "@opentelemetry/instrumentation-pg": "^0.77.0",
    "@opentelemetry/instrumentation-undici": "^0.34.0",
    "@opentelemetry/resources": "3.0.0",
    "@opentelemetry/sdk-metrics": "^3.0.0",
    "@opentelemetry/sdk-node": "^0.300.0",
    "@opentelemetry/sdk-trace": "^3.0.0",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "@prometheus-io/client": "0.16.1",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.45.1",
    "fastify": "^5.12.7",
    "ioredis": "^6.0.0",
    "jose": "^6.2.13",
    "opossum": "10.0.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "0.35.5",
    "ulid": "^3.0.2",
    "undici": "^8.12.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^12.0.10",
    "@nestjs/testing": "^12.2.0",
    "@seriousme/openapi-schema-validator": "^2.11.0",
    "@swc/cli": "^0.8.1",
    "@swc/core": "1.16.20",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.20.5",
    "@types/opossum": "8.1.9",
    "@types/pg": "^8.23.1",
    "@types/postman-collection": "^3.5.11",
    "@typescript/native": "npm:typescript@7.0.2",
    "ajv": "^8.20.0",
    "dependency-cruiser": "^18.7.0",
    "husky": "^9.1.7",
    "istanbul-lib-coverage": "3.2.2",
    "jest": "^29.7.0",
    "knip": "^6.42.1",
    "lint-staged": "^17.6.0",
    "mjml": "^5.4.1",
    "openapi-to-postmanv2": "^6.4.1",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "7.0.2005",
    "postman-collection": "^5.3.1",
    "prettier": "^3.9.10",
    "prisma": "7.10.1",
    "squawk-cli": "2.70.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
