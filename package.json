{
  "name": "aihub-be",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.20.0",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "migrate": "node scripts/migrate.mjs",
    "cli": "node scripts/cli.mjs",
    "dev:assertion": "node scripts/dev-sign-assertion.mjs",
    "demo:bootstrap": "node scripts/demo-bootstrap.mjs",
    "generate:openapi": "tsx scripts/generate-openapi.ts && biome format --write openapi.json",
    "validate:openapi": "node scripts/validate-openapi.mjs",
    "generate:postman": "tsx scripts/generate-postman.ts && biome format --write aihub.postman_collection.json",
    "canary:ai-writing": "tsx scripts/canary-ai-writing.ts",
    "vault:provision": "node ops/vault/provision-runtime-secrets.mjs",
    "vault:smoke": "node scripts/vault-smoke.mjs",
    "test": "jest --runInBand",
    "test:db": "jest --config jest.config.db.cjs --runInBand",
    "test:watch": "jest --watch",
    "type-check": "tsc --noEmit",
    "format": "biome format --write .",
    "lint": "oxlint . && biome check .",
    "arch-check": "node scripts/check-architecture.mjs",
    "verify": "pnpm lint && pnpm type-check && pnpm test && pnpm arch-check && pnpm validate:openapi",
    "prepare": "husky"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.943.0",
    "@aws-sdk/s3-request-presigner": "^3.943.0",
    "@fastify/cookie": "^10.0.1",
    "@fastify/multipart": "10.1.1",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-fastify": "^11.0.0",
    "@sinclair/typebox": "^0.34.41",
    "argon2": "^0.41.1",
    "fastify": "^5.2.1",
    "ioredis": "^6.0.0",
    "jose": "^5.10.0",
    "pg": "^8.23.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "ulid": "^3.0.2",
    "undici": "^7.29.1"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.0.0",
    "@seriousme/openapi-schema-validator": "^2.9.1",
    "@swc/cli": "^0.8.1",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.13.4",
    "@types/pg": "^8.23.1",
    "@types/postman-collection": "^3.5.11",
    "dependency-cruiser": "^17.3.7",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^17.5.0",
    "openapi-to-postmanv2": "^6.3.3",
    "oxlint": "^1.83.0",
    "postman-collection": "^5.3.1",
    "prettier": "^3.9.6",
    "tsx": "^4.23.13",
    "typescript": "^5.7.3"
  }
}
