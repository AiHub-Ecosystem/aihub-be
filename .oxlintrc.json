{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // `correctness` only. Every other category was measured against this
  // codebase before being left off; the numbers and the reasoning are in
  // https://github.com/AiHub-Ecosystem/aihub-be/issues/106#issuecomment-5770026510
  //
  // Severity lives here rather than in a `--deny-warnings` flag: oxlint exits
  // 0 on warnings, so `bun run lint` would report findings and still pass. Keeping
  // it in the config stops `bun run lint` and `.husky/pre-commit` from drifting.
  "options": {
    "typeAware": true
  },
  "categories": {
    "correctness": "error"
  },
  // `typescript`, `unicorn` and `oxc` are on by default. The other four are the
  // reason for adopting oxlint at all: Biome's `recommended` set has no import,
  // promise, Node or Jest rules. `jest` accounts for 18 of the 23 findings;
  // `import`, `promise` and `node` contribute nothing at `correctness` today;
  // they were enabled ahead of #110, whose type-aware rules are now on below.
  "plugins": [
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "promise",
    "node",
    "jest"
  ],
  "rules": {
    // `expect-expect` must recognize shared helpers that contain assertions.
    "jest/expect-expect": [
      "error",
      { "assertFunctionNames": ["expect", "expectRefused"] }
    ],
    // Ban `@ts-ignore`/`@ts-nocheck` and bare `@ts-expect-error`: the only
    // legal directive is a description-bearing `@ts-expect-error` (issue #811).
    "typescript/ban-ts-comment": [
      "error",
      {
        "ts-expect-error": "allow-with-description",
        "ts-ignore": true,
        "ts-nocheck": true,
        "ts-check": false,
        "minimumDescriptionLength": 3
      }
    ],
    // Both rules below belong to `suspicious`. That category measures 69
    // findings here, of which only these two are real: 10 are NestJS `@Module()`
    // classes, 24 are `.sort()` calls on freshly built arrays, and the rest are
    // spec-file idiom. Enabling the two by name keeps this a positive list —
    // nothing is switched off to make the run green.
    "promise/always-return": "error",
    "import/no-named-as-default-member": "error",
    // Type-aware rules for #110 — gateway defect class. `no-floating-promises`,
    // `no-misused-promises`, and `await-thenable` are the direct gateway failure
    // modes. They are `error` with 0 findings. Runtime measured at 2.6s (<8s),
    // so this set stays in `bun run verify`.
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    // Issue #823: no-unsafe rules stay enabled across JavaScript, TypeScript,
    // tests, and Prisma seeds; trust boundaries are typed in source.
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/unbound-method": "error",
    "typescript/no-base-to-string": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/no-misused-spread": "error",
    "typescript/require-array-sort-compare": "error"
  },
  "overrides": [
    {
      "files": ["src/**/*.ts"],
      "rules": {
        "complexity": ["error", 64],
        "max-depth": ["error", 4]
      }
    },
    {
      "files": ["src/**/*.spec.ts", "src/**/*.spec-support.ts"],
      "rules": {
        "no-unused-vars": "off"
      }
    },
    {
      "files": ["src/**/*.spec.ts", "src/**/testing/**"],
      "rules": {
        "complexity": "off",
        "max-depth": "off"
      }
    },
    {
      "files": [
        "src/modules/identity/user-assertions/infrastructure/jwks-key-provider.ts",
        "src/modules/speaking/application/speaking-audio-upload.sweep.ts",
        "src/modules/writing/application/writing-chart-upload.sweep.ts"
      ],
      "rules": {
        "complexity": "off",
        "max-depth": "off"
      }
    }
  ],
  // Mirrors `files.ignore` in biome.json. `test/fixtures` holds captured
  // downstream responses, which are data rather than source.
  "ignorePatterns": ["dist", "coverage", "node_modules", "test/fixtures"]
}
