# tsgolint is Go-based; keep its full-project type check within a single worker.
GOMAXPROCS=1 bunx lint-staged --hide-all
GOMAXPROCS=1 bun run oxlint --threads=1 .
if ! command -v gitleaks >/dev/null 2>&1; then
  echo "gitleaks not found on PATH. Install v8.30.1 from https://github.com/gitleaks/gitleaks/releases/tag/v8.30.1 (see docs/operations/secret-scanning.md) and retry." >&2
  exit 1
fi
gitleaks git --staged --config .gitleaks.toml --redact --no-banner
