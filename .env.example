NODE_ENV=development
PORT=3000

# Set true only for a local demo without a provisioned AIHUB API key.
AIHUB_ALLOW_UNAUTHENTICATED_DEV=false

# Hostnames that decide the request environment. Required in production —
# leaving these unset falls back to *.aihub.example.com placeholders, which
# will not match a real domain and every request will be rejected.
AIHUB_PRODUCTION_HOST=api.aihub.example.com
AIHUB_STAGING_HOST=staging-api.aihub.example.com
AIHUB_DEVELOPMENT_HOST=dev-api.aihub.example.com

DATABASE_URL=postgres://aihub:change-me@localhost:5432/aihub
REDIS_URL=redis://localhost:6379

DOWNSTREAM_AI_WRITING_URL=https://api-ielts-writing.aihubproduction.com
DOWNSTREAM_AI_WRITING_TOKEN=
