NODE_ENV=development
PORT=3000

# Runtime secret source. `env` is allowed only for this local development file;
# Dev/Production should use a Vault Agent-rendered JSON file instead.
AIHUB_RUNTIME_SECRET_SOURCE=env
AIHUB_RUNTIME_SECRETS_FILE=
AIHUB_AUTH_MFA_SECRETS_FILE=
AIHUB_RUNTIME_CONNECTION_SECRETS_FILE=
AIHUB_RUNTIME_DATABASE_SCOPE=production
AIHUB_USER_ACCESS_ISSUER=https://api.example.com

# Set true only for a local demo without a provisioned AIHUB API key.
AIHUB_ALLOW_UNAUTHENTICATED_DEV=false

# Hostnames that decide the request environment. Production is required in a
# production deployment; the other tiers are optional and absent when blank.
# Local development uses localhost, which resolves to the development tier.
AIHUB_PRODUCTION_HOST=
AIHUB_STAGING_HOST=
AIHUB_DEVELOPMENT_HOST=
AIHUB_SANDBOX_HOST=

DATABASE_URL=postgres://aihub:change-me@localhost:5432/aihub
CONTROL_PLANE_DATABASE_URL=
CONTROL_PLANE_READ_DATABASE_URL=
REDIS_URL=redis://localhost:6379

DOWNSTREAM_AI_WRITING_URL=https://api-ielts-writing.aihubproduction.com
DOWNSTREAM_AI_WRITING_TOKEN=

# Set this separately in each deployment (Dev/Staging/Production); do not
# reuse a production provider origin in a local or Dev environment.
DOWNSTREAM_AI_SPEAKING_URL=
DOWNSTREAM_AI_SPEAKING_CLIENT_ID=
DOWNSTREAM_AI_SPEAKING_SECRET_KEY=

# Resend API key stays in the runtime secret source; this is required for
# local-auth verification email delivery.
RESEND_API_KEY=
RESEND_FROM=no-reply@example.com

# Optional outside production. Unset (or blank): verification email keeps its
# token-only contract. Set: auth emails gain deep links into Customer Web.
CUSTOMER_WEB_BASE_URL=

# User Access JWT signing material. Keep the private key in the runtime secret
# source; the key id rotates with a deployment restart.
AIHUB_USER_ACCESS_JWT_PRIVATE_KEY=
AIHUB_USER_ACCESS_JWT_KID=

# Customer Web BFF client secret (POST /v1/auth/web-sessions and the rest of
# the Web Session routes). Optional in local development: blank leaves those
# routes answering 503 rather than serving an open route. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AIHUB_WEB_SESSION_CLIENT_SECRET=

# Email outbox payload keyring (ADR-0074). Queued auth and invitation emails are
# sealed with this key and erased at every terminal state, so a deployment that
# loses it loses whatever is still queued. Generate one key with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
# EMAIL_OUTBOX_KEYS is a JSON object of key id to base64 key, for example
#   {"local-2026-10":"<the value the command above printed>"}
# The current key id must be one of its keys and must not contain "." — that is
# the envelope delimiter. Rotating means adding the new id and keeping the old
# one until nothing is sealed with it: an instance without a key cannot read
# such a row, so it leaves it queued for an instance that can.
EMAIL_OUTBOX_CURRENT_KEY_ID=
EMAIL_OUTBOX_KEYS=

# Independent keyring for TOTP secrets stored in the MFA tables. In local env
# mode, generate a 32-byte base64 key and keep previous IDs while ciphertexts
# still use them. Production reads the separate Vault-rendered file above.
AIHUB_AUTH_MFA_CURRENT_KEY_ID=
AIHUB_AUTH_MFA_KEYS=

# Private Speaking sample-audio storage. The bucket is created by
# scripts/cli/upload-speaking-audio.mjs; credentials stay in the runtime secret
# source and are never returned to clients.
SEAWEEDFS_ENDPOINT_URL=https://s3.wispace.app
SEAWEEDFS_BUCKET=aihub-speaking-samples
SEAWEEDFS_REGION=us-east-1
# Private bucket for User Account Avatars (ADR-0068). No default: unset makes
# the Avatar routes answer AVATAR_STORAGE_UNAVAILABLE, never another bucket.
SEAWEEDFS_USER_ASSET_BUCKET=
# The Sandbox deployment's own Avatar bucket; it must differ from the one above
# (ADR-0068). Only the production compose file reads this name.
SEAWEEDFS_SANDBOX_USER_ASSET_BUCKET=
# Dedicated private Speaking Audio buckets. WISPACE must provision each
# environment's bucket and confirm its private policy before setting it.
SEAWEEDFS_AUDIO_ASSET_BUCKET=
SEAWEEDFS_SANDBOX_AUDIO_ASSET_BUCKET=
SEAWEEDFS_ACCESS_KEY_ID=
SEAWEEDFS_SECRET_ACCESS_KEY=

# Demo only: user id that scripts/cli/dev-sign-assertion.mjs signs assertions for.
DEMO_USER_ID=student_456
DEMO_ASSERTION_ISSUER=https://demo.acme.edu

# Sandbox assertion minting (POST /v1/sandbox/assertions).
# Leave these unset and the route does not exist; the rest of the gateway is
# unaffected. All three are needed — an allowlist without a key would accept a
# request it cannot answer. The key signs for the sandbox organization only:
# register its public half on that organization with `pnpm cli identity:set`,
# and make sure the key id below matches a `kid` in that registered key set.
# Signing is RS256. Escaped newlines in the PEM are restored on read.
AIHUB_SANDBOX_ORG_IDS=
AIHUB_SANDBOX_ASSERTION_PRIVATE_KEY=
AIHUB_SANDBOX_ASSERTION_KID=

# Monthly request quota, in requests, for an Organization created through
# self-serve (POST /v1/organizations). Must be a positive integer; blank uses
# the built-in default of 100. Only affects Organizations created afterwards.
AIHUB_SELF_SERVE_MONTHLY_REQUEST_QUOTA=

# Optional OpenTelemetry OTLP/HTTP trace receiver. Blank disables tracing.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_SERVICE_NAME=aihub-be

# Verbosity of the structured `request_completed` line Fastify writes to stdout.
# One of Pino's levels: trace, debug, info, warn, error, fatal, silent.
LOG_LEVEL=info
