{
  "openapi": "3.1.0",
  "info": { "title": "AIHUB fixture", "version": "1" },
  "paths": {
    "/v1/items": {
      "get": {
        "responses": {
          "200": {
            "description": "Items",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string" },
                    "status": { "type": "string", "enum": ["ready"] }
                  },
                  "required": ["id", "status"],
                  "additionalProperties": false
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "code": {
                      "type": "string",
                      "x-extensible-enum": ["INVALID_REQUEST"]
                    }
                  },
                  "required": ["code"]
                }
              }
            }
          }
        }
      }
    }
  }
}
