    {
      "name": "D1 handover test cases (docs/aihub_deliverable_1_api_contract_schema.md §G)",
      "item": [
        {
          "name": "1a. Valid request routes to Task 1 question generation",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-API-Key",
                "value": "{{apiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"chart_type\": \"Bar Chart\"\n}"
            },
            "url": "{{baseUrl}}/v1/writing/task1/questions",
            "description": "Valid API key + valid request routes to the correct AI Service operation."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responds with HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('success envelope carries the right operation and an AIHUB-generated request id', function () {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body.meta.operation).to.eql('writing.task1.question.generate');",
                  "  pm.expect(body.meta.service).to.eql('ai-writing');",
                  "  pm.expect(body.meta.request_id).to.match(/^req_[0-9A-HJKMNP-TV-Z]{26}$/);",
                  "});"
                ]
              }
            }
          ]
        },
